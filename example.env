# example.env — placeholders for local development
# Copy this to ".env" (or split into client/.env and server/.env).

# ---------------------------
# Server (Node) configuration
# ---------------------------
PORT=4000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/dairy_predictive_dev
JWT_SECRET=change_me_to_a_strong_secret
JWT_EXPIRES_IN=7d
GEMINI_API_KEY=your_gemini_api_key_here
CLIENT_URL=http://localhost:5173
SENTRY_DSN=
LOG_LEVEL=info

# Optional services
REDIS_URL=redis://localhost:6379
POSTGRES_URL=postgresql://user:pass@localhost:5432/dairydb

# Email (SMTP) for notifications
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USER=example@example.com
EMAIL_PASS=supersecret

# ---------------------------
# Client (Vite) configuration
# ---------------------------
# Vite exposes vars prefixed with VITE_
VITE_API_BASE_URL=https://dairy-predictive.onrender.com/api
VITE_SENTRY_DSN=
VITE_GEMINI_API_KEY=

# Notes:
# - Never commit secrets to source control. Use a .env (ignored) for local secrets.
# - For production, provide these values from a secure secret store or CI/CD pipeline.
