# example.env — placeholders for local development
# Copy the server values to server/.env and the client values to client/.env.
# Never commit real secrets or production credentials.

# ---------------------------
# Server (Node) configuration
# ---------------------------
PORT=4000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/dairy_predictive_dev
JWT_SECRET=change_me_to_a_strong_secret
JWT_EXPIRES_IN=7d
GEMINI_API_KEY=your_gemini_api_key_here
CLIENT_URL=http://localhost:5173
SENTRY_DSN=
LOG_LEVEL=info

# Optional services
REDIS_URL=redis://localhost:6379
POSTGRES_URL=postgresql://user:pass@localhost:5432/dairydb

# Email (SMTP) for notifications
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USER=example@example.com
EMAIL_PASS=change_me

# ---------------------------
# Client (Vite) configuration
# ---------------------------
# This value is compiled into the browser bundle.
# Local development: use the backend API directly.
VITE_API_BASE_URL=http://localhost:4000/api/v1
VITE_SENTRY_DSN=

# Do NOT put GEMINI_API_KEY in a VITE_ variable.
# Gemini credentials must remain server-side.

# ---------------------------
# Destructive seed safety gate
# ---------------------------
# The default `npm run seed` command is blocked unless both values are set.
# Never enable destructive seeding in production.
SEED_ALLOW_DESTRUCTIVE=false
SEED_CONFIRM=

# Production:
# Set VITE_API_BASE_URL in the Vercel project's environment variables.
# It must point to the deployed Express API's /api/v1 base path.
